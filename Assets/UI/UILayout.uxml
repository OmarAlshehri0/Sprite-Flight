<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 8px; align-self: center; font-size: 17px; color: rgb(255, 255, 255);"/>
    <ui:Button text="Restar" name="RestartButton" style="position: absolute; top: 50%; align-self: center; font-size: 20px; -unity-font-style: bold; background-color: rgb(0, 78, 123); -unity-background-image-tint-color: rgb(0, 0, 0);"/>
    <ui:Label text="Top Score: 0" name="HighScoreLabel" style="top: -25px; align-self: center; font-size: 17px; color: rgb(218, 165, 32); right: 0; left: -190px;"/>
</ui:UXML>
